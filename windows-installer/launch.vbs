' Shia Azan - Silent launcher
' Runs the browser in app mode without showing a console window.
'
' This file is generated by the installer with the detected browser
' path. If you're running it manually, edit the BROWSER_PATH constant
' below to point to your Chrome or Edge executable.

Option Explicit

Const APP_URL = "https://preview-2191f985-b65d-42d8-9600-cb5576d395da.space-z.ai/"

' Try to detect the browser automatically
Dim shell, fso, browserPath, browserName

Set shell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' Check Microsoft Edge (64-bit)
browserPath = ""
browserName = ""

If fso.FileExists(shell.ExpandEnvironmentStrings("%ProgramFiles%\Microsoft\Edge\Application\msedge.exe")) Then
    browserPath = shell.ExpandEnvironmentStrings("%ProgramFiles%\Microsoft\Edge\Application\msedge.exe")
    browserName = "Microsoft Edge"
ElseIf fso.FileExists(shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%\Microsoft\Edge\Application\msedge.exe")) Then
    browserPath = shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%\Microsoft\Edge\Application\msedge.exe")
    browserName = "Microsoft Edge"
ElseIf fso.FileExists(shell.ExpandEnvironmentStrings("%ProgramFiles%\Google\Chrome\Application\chrome.exe")) Then
    browserPath = shell.ExpandEnvironmentStrings("%ProgramFiles%\Google\Chrome\Application\chrome.exe")
    browserName = "Google Chrome"
ElseIf fso.FileExists(shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%\Google\Chrome\Application\chrome.exe")) Then
    browserPath = shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%\Google\Chrome\Application\chrome.exe")
    browserName = "Google Chrome"
ElseIf fso.FileExists(shell.ExpandEnvironmentStrings("%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe")) Then
    browserPath = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe")
    browserName = "Google Chrome"
End If

If browserPath = "" Then
    MsgBox "No supported browser found." & vbCrLf & vbCrLf & _
           "Please install Microsoft Edge or Google Chrome to run Shia Azan.", _
           vbCritical, "Shia Azan"
    WScript.Quit 1
End If

' Launch the browser in app mode (--app=URL opens the URL in a
' standalone window without browser chrome, making it behave like a
' native desktop application).
shell.Run """" & browserPath & """ --app=""" & APP_URL & """ --app-name=""Shia Azan"" --app-id=""shiaazan""", 1, False

Set shell = Nothing
Set fso = Nothing
